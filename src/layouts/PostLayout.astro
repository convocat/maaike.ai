---
import PageLayout from './PageLayout.astro';
import TagList from '../components/TagList.astro';
import WikiLinkPreview from '../components/WikiLinkPreview.astro';
import CollectionIcon from '../components/CollectionIcon.astro';
import PostSidebar from '../components/PostSidebar.astro';
import ShareLinkedIn from '../components/ShareLinkedIn.astro';
import CopyCardImage from '../components/CopyCardImage.astro';

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  maturity: 'draft' | 'developing' | 'solid' | 'complete' | 'compost';
  tags: string[];
  triples?: [string, string, string][];
  themes?: string[];
  open_questions?: string[];
  description?: string;
  collection: string;
  collectionOverride?: string;
  slug: string;
  url?: string;
  ai?: '100% Maai' | 'assisted' | 'co-created' | 'generated';
  hub?: boolean;
  develops?: string;
  backHref?: string;
  backLabel?: string;
  postUrlOverride?: string;
  ogImageOverride?: string;
}

// Markdown layout pages pass all frontmatter under Astro.props.frontmatter;
// content collection routes pass props directly.
const source = Astro.props.frontmatter ?? Astro.props;
const { title, updated, maturity, tags, triples, themes, open_questions, description, collection: collectionProp, collectionOverride, slug, url, ai, hub, develops, backHref = '/', backLabel = 'Stream', postUrlOverride, ogImageOverride } = source;
const collection = collectionOverride ?? collectionProp;
const date = source.date instanceof Date ? source.date : new Date(source.date);

const isHub = hub === true;
const ogImage = ogImageOverride ?? `/images/og/${collection}/${slug}.png`;
const postUrl = postUrlOverride ?? `https://maaike.ai/${collection}/${slug}/`;

const aiLabels: Record<string, { label: string; description: string }> = {
  '100% Maai': { label: '100% Maai', description: 'Fully written by me.' },
  assisted: { label: 'AI-assisted', description: 'My ideas and structure, AI helped refine.' },
  'co-created': { label: 'Co-created with AI', description: 'Written by AI based on my ideas and direction.' },
  generated: { label: 'AI-generated', description: 'Fully generated by AI, reviewed by me.' },
};

const stageMap: Record<string, { emoji: string; label: string }> = {
  draft: { emoji: '🌱', label: 'Seed' },
  developing: { emoji: '🌿', label: 'Sapling' },
  solid: { emoji: '🪴', label: 'Plant' },
  complete: { emoji: '🌳', label: 'Tree' },
};

const isCompost = maturity === 'compost';
const stage = stageMap[maturity];

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const formattedUpdated = updated
  ? new Intl.DateTimeFormat('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updated)
  : null;

const chatPageContext = {
  type: 'post',
  title,
  description: description ?? '',
  url: `/${collection}/${slug}/`,
  collection,
  slug,
  tags: tags ?? [],
  themes: themes ?? [],
  triples: triples ?? [],
  open_questions: open_questions ?? [],
  maturity: maturity ?? '',
};
---

<PageLayout title={title} description={description} ogImage={ogImage} pageContext={chatPageContext}>
  <a href={backHref} class="back-to-stream">&larr; {backLabel}</a>
  <div class="post-with-sidebar">
    <article class="post">
      <header class="post-header">
        <div class="post-collection-label">
          <CollectionIcon collection={collection} size={16} />
          <span>{collection.replace(/-/g, ' ')}</span>
          {isHub && <span class="project-badge">Project hub</span>}
        </div>
        <h1>{title}</h1>
        {description && <p class="post-subtitle">{description}</p>}
        {url && url.startsWith('http') && collection !== 'videos' && (
          <a href={url} class="external-link" target="_blank" rel="noopener noreferrer">
            {new URL(url).hostname.replace('www.', '')} ↗
            <span class="visually-hidden">(opens in new window)</span>
          </a>
        )}
        <div class="meta-line">
          <span class="meta-pill meta-pill--published">
            <span class="meta-pill-label">Published</span>
            <span class="meta-pill-value"><time datetime={date.toISOString()}>{formattedDate}</time></span>
          </span>
          {formattedUpdated && (
            <span class="meta-pill meta-pill--tended">
              <span class="meta-pill-label">Tended</span>
              <span class="meta-pill-value">{formattedUpdated}</span>
            </span>
          )}
          {isCompost ? (
            <span class="meta-pill meta-pill--compost">
              <span class="meta-pill-label">Maturity</span>
              <span class="meta-pill-value">🍂 Composted</span>
            </span>
          ) : stage ? (
            <span class="meta-pill meta-pill--maturity">
              <span class="meta-pill-label">Maturity</span>
              <span class="meta-pill-value">{stage.emoji} {stage.label}</span>
            </span>
          ) : null}
          {ai && aiLabels[ai] && (
            <span class="meta-pill meta-pill--ai">
              <span class="meta-pill-label">AI</span>
              <span class="meta-pill-value">{aiLabels[ai].label}</span>
            </span>
          )}
          {ai && aiLabels[ai] && (
            <span class="meta-desc">{aiLabels[ai].description}</span>
          )}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        {(tags.length > 0 || (triples && triples.length > 0) || (themes && themes.length > 0) || (open_questions && open_questions.length > 0)) && (
          <details class="mycelium-section">
            <summary class="mycelium-summary">
              <span class="mycelium-label">Mycelium</span>
              <span class="mycelium-hint">tags, relations, arguments &amp; questions</span>
            </summary>
            <div class="mycelium-content">
              {tags.length > 0 && (
                <div class="post-footer-tags">
                  <TagList tags={tags} />
                </div>
              )}
              {triples && triples.length > 0 && (
                <div class="post-footer-triples">
                  <h3 class="post-footer-heading">Relations</h3>
                  <ul class="triples-list">
                    {triples.map(([s, p, o]) => (
                      <li class="triple">
                        <span class="triple-subject">{s}</span>
                        <span class="triple-predicate">{p}</span>
                        <span class="triple-object">{o}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {themes && themes.length > 0 && (
                <div class="post-footer-themes">
                  <h3 class="post-footer-heading">
                    What this post argues
                    <span class="beta-badge">beta</span>
                  </h3>
                  <ul class="themes-list">
                    {themes.map((theme) => (
                      <li class="theme-item">{theme}</li>
                    ))}
                  </ul>
                </div>
              )}
              {open_questions && open_questions.length > 0 && (
                <div class="post-footer-questions">
                  <h3 class="post-footer-heading">Questions this raises</h3>
                  <ul class="questions-list">
                    {open_questions.map((q) => (
                      <li class="question-item">{q}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </details>
        )}
        <div class="post-footer-share">
          <h3 class="post-footer-heading">Share</h3>
          <div class="post-footer-share-buttons">
            <CopyCardImage imagePath={ogImage} />
            <button class="share-generic" data-url={postUrl} data-title={title} aria-label="Copy link">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" filter="url(#sketchy)" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
                <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
              </svg>
              <span>Copy link</span>
            </button>
            <ShareLinkedIn url={postUrl} title={title} />
          </div>
        </div>
      </footer>
    </article>

    <aside class="post-sidebar">
      <PostSidebar slug={slug} tags={tags} collection={collection} title={title} postUrl={postUrl} hub={hub} develops={develops} />
    </aside>
  </div>
  <WikiLinkPreview />
</PageLayout>

<script>
  // Open external links in prose in a new tab
  document.querySelectorAll('.prose a[href^="http"]').forEach((link) => {
    const url = link.getAttribute('href') || '';
    if (!url.startsWith('https://maaike.ai') && !url.startsWith('http://maaike.ai')) {
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer');
    }
  });

  document.querySelectorAll('.share-generic').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url') || '';
      const title = btn.getAttribute('data-title') || '';
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {}
      } else {
        await navigator.clipboard.writeText(url);
        const label = btn.querySelector('span');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = original; }, 2000);
        }
      }
    });
  });
</script>

<style>
  .back-to-stream {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-lg);
    transition: color 150ms;
  }
  .back-to-stream:hover { color: var(--color-accent); }

  .post-with-sidebar {
    display: grid;
    grid-template-columns: 1fr 14rem;
    gap: var(--space-xl);
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .post {
    min-width: 0;
  }

  .post-sidebar {
    padding-block-start: var(--space-3xl);
    opacity: 0.85;
  }

  @media (max-width: 68rem) {
    .post-with-sidebar {
      grid-template-columns: 1fr;
    }

    .post-sidebar {
      padding-block-start: 0;
      margin-block-start: var(--space-xl);
      padding-block-start: var(--space-xl);
      border-top: 1px solid var(--color-border);
    }
  }

  .post-header {
    margin-block-end: var(--space-3xl);
    padding-block-end: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .post-collection-label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.8rem;
    text-transform: capitalize;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    margin-block-start: var(--space-sm);
  }

  .project-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 0.3rem;
    padding: 0.1rem 0.4rem;
    margin-inline-start: var(--space-xs);
  }

  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin-block: var(--space-md) var(--space-xs);
  }

  .post-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-block: var(--space-xs) var(--space-md);
    font-family: var(--font-body);
    font-weight: 400;
  }

  .external-link {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--color-accent);
    text-decoration: none;
    margin-block-end: var(--space-sm);
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.5rem;
    font-size: 0.82rem;
    margin-block-start: var(--space-sm);
  }

  .meta-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.12rem 0.7rem;
    line-height: 1.5;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .meta-pill-label {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .meta-pill-value {
    font-size: 0.78rem;
    color: var(--color-text);
  }

  .meta-pill-value time {
    font: inherit;
    color: inherit;
  }

  /* Earth-tone palette : wheat, sage, clay, stone */
  .meta-pill--published {
    background: #F0E8D6;
    border-color: #DCD0B0;
  }
  .meta-pill--published .meta-pill-label { color: #7A6539; }

  .meta-pill--tended {
    background: #DCE3CA;
    border-color: #BFC9A8;
  }
  .meta-pill--tended .meta-pill-label { color: #5A6B45; }

  .meta-pill--maturity {
    background: #E5D5C2;
    border-color: #CFBC9F;
  }
  .meta-pill--maturity .meta-pill-label { color: #7A5A3D; }

  .meta-pill--compost {
    background: #D9C0A4;
    border-color: #BFA384;
  }
  .meta-pill--compost .meta-pill-label { color: #6B4A2C; }

  .meta-pill--ai {
    background: #DDD6CC;
    border-color: #C5BCAE;
  }
  .meta-pill--ai .meta-pill-label { color: #5C5448; }

  .meta-desc {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-left: 0.1rem;
  }

  /* Dark mode : same earth families, darker, lower-saturation */
  :global([data-theme="dark"]) .meta-pill--published {
    background: #2A2618; border-color: #4A402A;
  }
  :global([data-theme="dark"]) .meta-pill--published .meta-pill-label { color: #C9B27A; }

  :global([data-theme="dark"]) .meta-pill--tended {
    background: #1F2A1B; border-color: #364530;
  }
  :global([data-theme="dark"]) .meta-pill--tended .meta-pill-label { color: #A8C078; }

  :global([data-theme="dark"]) .meta-pill--maturity {
    background: #2A2118; border-color: #44382A;
  }
  :global([data-theme="dark"]) .meta-pill--maturity .meta-pill-label { color: #C99A78; }

  :global([data-theme="dark"]) .meta-pill--compost {
    background: #2E1F12; border-color: #4A3520;
  }
  :global([data-theme="dark"]) .meta-pill--compost .meta-pill-label { color: #BF8A60; }

  :global([data-theme="dark"]) .meta-pill--ai {
    background: #24221E; border-color: #3D3A33;
  }
  :global([data-theme="dark"]) .meta-pill--ai .meta-pill-label { color: #B5AC9C; }

  .post-footer {
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .post-footer-tags {
    margin-block-end: var(--space-md);
  }

  .mycelium-section {
    margin-block-end: var(--space-lg);
    border-top: 1px solid var(--color-border);
    padding-block-start: var(--space-md);
  }

  .mycelium-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    user-select: none;
    padding-block: var(--space-xs);
  }

  .mycelium-summary::-webkit-details-marker {
    display: none;
  }

  .mycelium-label {
    font-size: 1.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    position: relative;
    padding-left: 1.4rem;
  }

  .mycelium-label::before {
    content: '▶';
    position: absolute;
    left: 0;
    font-size: 0.65rem;
    color: var(--color-accent);
    opacity: 0.6;
    transition: transform 150ms ease;
    top: 0.45em;
  }

  .mycelium-section[open] .mycelium-label::before {
    transform: rotate(90deg);
  }

  .mycelium-hint {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.6;
    font-style: italic;
  }

  .mycelium-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
    animation: slide-down 200ms ease;
  }

  @keyframes slide-down {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .post-footer-triples,
  .post-footer-themes,
  .post-footer-questions {
    background: var(--color-bg-card);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: var(--space-md) var(--space-lg);
  }

  .post-footer-themes .post-footer-heading {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .post-footer-triples .triples-list,
  .post-footer-themes .themes-list,
  .post-footer-questions .questions-list {
    margin-block-start: var(--space-sm);
  }

  .beta-badge {
    font-size: 0.6rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 3px;
    padding: 1px 5px;
    opacity: 0.7;
    vertical-align: middle;
  }

  .themes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .theme-item {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    padding-left: var(--space-sm);
    position: relative;
  }

  .theme-item::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.5;
    font-size: 0.75rem;
    top: 0.15em;
  }

  .questions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .question-item {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.5;
    padding-left: var(--space-sm);
    position: relative;
  }

  .question-item::before {
    content: '?';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.5;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 600;
    top: 0.1em;
  }

  .triples-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .triple {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .triple-subject {
    font-weight: 600;
    color: var(--color-text);
  }

  .triple-predicate {
    font-style: italic;
    opacity: 0.7;
  }

  .triple-object {
    font-weight: 500;
  }

  .post-footer-heading {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-block-end: var(--space-xs);
  }

  .post-footer-share-buttons {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  .share-generic {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    padding: 0.5rem 0.6rem;
    min-height: 44px;
    border-radius: 0.4rem;
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.2s, background 0.2s;
  }

  .share-generic:hover {
    color: var(--color-accent);
    background: var(--color-tag-bg);
  }
</style>
