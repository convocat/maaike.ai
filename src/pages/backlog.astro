---
import PageLayout from '../layouts/PageLayout.astro';
import { marked } from 'marked';
import fs from 'fs';
import path from 'path';

const backlogPath = path.resolve('.claude/backlog.md');
const raw = fs.readFileSync(backlogPath, 'utf-8');

// Strip the header block (everything up to and including the first ---)
const withoutHeader = raw.replace(/^[\s\S]*?---\n\n/, '');

// Render markdown
let html = marked(withoutHeader) as string;

// Replace [STATUS] markers with styled pill spans.
// Match in headings (h2/h3) and inline body text.
const statusToClass: Record<string, string> = {
  'READY':       'pill-ready',
  'IN PROGRESS': 'pill-progress',
  'PARKED':      'pill-parked',
  'DONE':        'pill-done',
};

html = html.replace(/\[(READY|IN PROGRESS|PARKED|DONE)\]/g, (_m, label) => {
  const cls = statusToClass[label];
  return `<span class="status-pill ${cls}">${label}</span>`;
});
---

<PageLayout title="Backlog — Maai & AI" description="What I'm working on and what's queued up next.">
  <div class="backlog-header">
    <h1>Backlog</h1>
    <p class="backlog-intro">What's queued up. Sessions as branches: each thread picks up one item.</p>
    <div class="status-legend">
      <span class="status-pill pill-ready">READY</span>
      <span class="status-pill pill-progress">IN PROGRESS</span>
      <span class="status-pill pill-parked">PARKED</span>
      <span class="status-pill pill-done">DONE</span>
    </div>
  </div>

  <div class="backlog-entries" set:html={html} />
</PageLayout>

<style>
  .backlog-header {
    margin-block-end: var(--space-2xl);
  }

  .backlog-header h1 {
    margin-block-end: var(--space-sm);
  }

  .backlog-intro {
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    margin-block-end: var(--space-md);
  }

  .status-legend {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    align-items: center;
  }

  /* Pill styling — applies inside header legend AND inside rendered markdown */
  :global(.status-pill) {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    border: 1px solid transparent;
    line-height: 1.4;
    vertical-align: middle;
    margin-inline-end: 0.4rem;
    white-space: nowrap;
  }

  /* READY — moss green (primary accent family) */
  :global(.pill-ready) {
    background: #E8EFE5;
    color: #3E5638;
    border-color: #C9D6C2;
  }
  :global([data-theme="dark"] .pill-ready) {
    background: #2C3A28;
    color: #B8D2A6;
    border-color: #4A5C42;
  }

  /* IN PROGRESS — warm bronze (secondary accent family) */
  :global(.pill-progress) {
    background: #F2EBDC;
    color: #6F5728;
    border-color: #D9CCA8;
  }
  :global([data-theme="dark"] .pill-progress) {
    background: #3E3320;
    color: #E8C795;
    border-color: #5C4A2E;
  }

  /* PARKED — neutral muted */
  :global(.pill-parked) {
    background: #ECEAE5;
    color: #6B6457;
    border-color: #D4D0C7;
  }
  :global([data-theme="dark"] .pill-parked) {
    background: #2E2C28;
    color: #B8B2A4;
    border-color: #4A4640;
  }

  /* DONE — terracotta, low-emphasis */
  :global(.pill-done) {
    background: #F5E8E0;
    color: #8A3F26;
    border-color: #E0CBBC;
    opacity: 0.85;
  }
  :global([data-theme="dark"] .pill-done) {
    background: #3A2820;
    color: #D88A6A;
    border-color: #5A3E32;
    opacity: 0.85;
  }

  /* Active items — h2 */
  .backlog-entries :global(h2) {
    font-size: 1.2rem;
    line-height: 1.35;
    margin-block-start: var(--space-2xl);
    margin-block-end: var(--space-xs);
    padding-block-end: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Pill inside h2 inherits its size baseline; reset to fixed pill size */
  .backlog-entries :global(h2 .status-pill),
  .backlog-entries :global(h3 .status-pill) {
    font-size: 0.7rem;
    align-self: center;
  }

  /* Archive items — h3 (smaller, muted) */
  .backlog-entries :global(h3) {
    font-size: 0.95rem;
    line-height: 1.4;
    margin-block-start: var(--space-md);
    margin-block-end: var(--space-2xs, 0.15rem);
    color: var(--color-text-muted);
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Archive heading itself (## Archive) — make distinct */
  .backlog-entries :global(h2:has(+ h3)),
  .backlog-entries :global(h2:not(:has(.status-pill))) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    margin-block-start: calc(var(--space-3xl) + var(--space-lg));
    color: var(--color-heading);
  }

  /* Date line under each item */
  .backlog-entries :global(h2 + p),
  .backlog-entries :global(h3 + p) {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-block-end: var(--space-md);
  }

  .backlog-entries :global(h3 + p) {
    margin-block-end: var(--space-sm);
    font-size: 0.78rem;
  }

  /* Body content under active items */
  .backlog-entries :global(h2 ~ p),
  .backlog-entries :global(h2 ~ ul),
  .backlog-entries :global(h2 ~ ol) {
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* Body lists — tighter */
  .backlog-entries :global(ul),
  .backlog-entries :global(ol) {
    margin-block-start: var(--space-sm);
    margin-block-end: var(--space-md);
    padding-inline-start: 1.4rem;
  }

  .backlog-entries :global(li) {
    margin-block-end: 0.3rem;
  }

  /* Opening message blockquotes */
  .backlog-entries :global(blockquote) {
    border-inline-start: 3px solid var(--color-accent);
    background: var(--color-bg-card, #FAFAFA);
    margin-block: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text);
    font-style: normal;
    border-radius: 0 0.4rem 0.4rem 0;
  }

  .backlog-entries :global(blockquote p) {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Inline code (file paths, slugs) */
  .backlog-entries :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.85em;
    background: var(--color-bg-card, #F5F4F0);
    padding: 0.1em 0.35em;
    border-radius: 0.25em;
    color: var(--color-text);
  }

  .backlog-entries :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-xl);
    opacity: 0.4;
  }

  /* Strong labels (e.g. "**NEW:**", "**Opening message:**") */
  .backlog-entries :global(strong) {
    color: var(--color-heading);
  }

  /* Mobile */
  @media (max-width: 600px) {
    .backlog-entries :global(h2) {
      font-size: 1.05rem;
    }
    .backlog-entries :global(blockquote) {
      padding: var(--space-xs) var(--space-sm);
    }
  }
</style>
