---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import tao from '../data/triples.json';

// External sources = weblinks with at least one association in the knowledge graph.
// (The old tao.sources object was retired — every external URL is now a weblink.)
const weblinks = await getCollection('weblinks', (entry) => !entry.data.draft);

const sources = weblinks.map((entry) => {
  const slug = entry.id;
  const assocs = tao.associations.filter((a: any) => a.source === slug);
  const topicIds = new Set<string>();
  for (const a of assocs) {
    topicIds.add(a.subject);
    topicIds.add(a.object);
  }
  const topics = [...topicIds].map((tid) => ({
    id: tid,
    label: (tao.topics as any)[tid]?.label || tid,
    type: (tao.topics as any)[tid]?.type || 'concept',
  }));
  return {
    id: slug,
    label: entry.data.title,
    url: entry.data.url,
    date: (entry.data.date as Date).toISOString().slice(0, 10),
    summary: entry.data.description || '',
    topics,
    associations: assocs.map((a: any) => ({
      subject: (tao.topics as any)[a.subject]?.label || a.subject,
      predicate: a.predicate,
      object: (tao.topics as any)[a.object]?.label || a.object,
    })),
    assocCount: assocs.length,
  };
})
  // Only show weblinks that actually contribute to the graph
  .filter((s) => s.assocCount > 0)
  .sort((a, b) => b.date.localeCompare(a.date));
---

<PageLayout title="Sources" description="Ingested external references feeding the knowledge graph.">
  <div class="sources-page">
    <h1>Sources</h1>
    <p class="intro">
      External references ingested via <code>/ingest-source</code>.
      {sources.length} {sources.length === 1 ? 'source' : 'sources'} ingested.
    </p>

    {sources.length === 0 ? (
      <p class="empty">No sources ingested yet. Run <code>/ingest-source</code> or <code>/telegram-sync</code> to add external references.</p>
    ) : (
      <div class="source-list">
        {sources.map(s => (
          <article class="source-card">
            <div class="source-header">
              <h2 class="source-title">
                <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
              </h2>
              <span class="source-date">{s.date}</span>
            </div>
            {s.summary && <p class="source-summary">{s.summary}</p>}
            <div class="source-topics">
              {s.topics.map(t => (
                <a href={`/topics/${t.id}`} class="topic-badge">{t.label}</a>
              ))}
            </div>
            <div class="source-assocs">
              {s.associations.map(a => (
                <span class="assoc">{a.subject} <em>{a.predicate}</em> {a.object}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</PageLayout>

<style>
  .sources-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-lg) 0 var(--space-2xl);
  }
  h1 { font-family: var(--font-heading); font-size: 1.75rem; margin-bottom: var(--space-xs); }
  .intro {
    color: var(--color-text-muted); font-size: 0.875rem;
    margin-bottom: var(--space-xl); line-height: 1.5;
  }
  .intro code {
    font-family: var(--font-mono); font-size: 0.82em;
    background: var(--color-bg-card); padding: 0.1em 0.35em; border-radius: 3px;
  }
  .empty {
    color: var(--color-text-muted); font-size: 0.9rem;
    text-align: center; padding: var(--space-2xl); line-height: 1.6;
  }
  .empty code {
    font-family: var(--font-mono); font-size: 0.82em;
    background: var(--color-bg-card); padding: 0.1em 0.35em; border-radius: 3px;
  }

  .source-list { display: flex; flex-direction: column; gap: var(--space-lg); }

  .source-card {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: var(--space-md) var(--space-lg);
  }
  .source-header {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-sm); margin-bottom: var(--space-sm);
  }
  .source-title { font-family: var(--font-heading); font-size: 1rem; margin: 0; }
  .source-title a { color: var(--color-text); text-decoration: none; }
  .source-title a:hover { color: var(--color-accent); }
  .source-date { font-size: 0.72rem; color: var(--color-text-muted); white-space: nowrap; }

  .source-summary {
    font-size: 0.85rem; line-height: 1.6; color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .source-topics {
    display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: var(--space-sm);
  }
  .topic-badge {
    font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 10px;
    background: rgba(0,0,0,0.05); color: var(--color-text);
    text-decoration: none; transition: background 150ms, color 150ms;
  }
  :root[data-theme="dark"] .topic-badge { background: rgba(255,255,255,0.08); }
  .topic-badge:hover { background: var(--color-accent); color: white; }

  .source-assocs {
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .assoc {
    font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.4;
  }
  .assoc em { color: var(--color-accent-2); font-style: italic; }
</style>
