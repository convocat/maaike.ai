---
const eventUrl = 'https://luma.com/event/evt-6tpr1mAGIC6rtNj';
const eventId = 'evt-6tpr1mAGIC6rtNj';
const iframeSrc = `https://luma.com/embed/event/${eventId}/simple`;
const humicUrl = 'https://store.surrey.ac.uk/conferences-and-events/fabss-faculty-of-arts-business-and-social-sciences/conferences-and-events/humic-humans-and-machines-in-conversation-linguistic-social-and-relational-perspectives';
const title = 'Convoclub IRL · Wednesday 17 June 2026 · University of Surrey';
const description = "The very first Convoclub IRL: a casual, community-driven day for conversation designers, linguists, AI folks and anyone who loves the way humans and machines talk. Guildford, Wednesday 17 June 2026.";
const canonical = 'https://www.maaike.ai/convoclubirl';
const ogImage = 'https://www.maaike.ai/images/og-convoclubirl.png';

const faqs = [
  {
    q: 'When and where is Convoclub IRL?',
    a: 'Wednesday 17 June 2026, from 09:30 to 16:30, at the University of Surrey, Guildford campus (Stag Hill, University Campus, Guildford GU2 7XH, United Kingdom). Around 35 minutes from London Waterloo by train.',
  },
  {
    q: 'How much does it cost?',
    a: 'Free. Spots are limited, so register early. If we fill up, the Luma waitlist will open and Maaike will release spots as they free up.',
  },
  {
    q: 'Who can attend?',
    a: 'Convoclub members and curious newcomers alike. Conversation designers, linguists, AI folks, and anyone who loves language and the way humans and machines talk. Not a member yet? Come hang out at convo.club.',
  },
  {
    q: 'Do I need to attend HUMIC too?',
    a: 'No. Convoclub IRL is a stand-alone day. It runs the day after the HUMIC symposium at the same venue, so you can also treat it as an add-on. Each event has its own registration page.',
  },
  {
    q: 'How do I propose a session or topic?',
    a: 'There is space on the Luma registration form to suggest a session, ask-me-anything, portfolio review, or topic. The full programme is co-designed with the community.',
  },
  {
    q: 'What language will the day be in?',
    a: 'English.',
  },
];

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Convoclub IRL',
  description,
  image: [ogImage],
  startDate: '2026-06-17T09:30:00+01:00',
  endDate: '2026-06-17T16:30:00+01:00',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  url: canonical,
  location: {
    '@type': 'Place',
    name: 'University of Surrey, Guildford campus',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Stag Hill, University Campus',
      addressLocality: 'Guildford',
      postalCode: 'GU2 7XH',
      addressCountry: 'GB',
    },
  },
  organizer: {
    '@type': 'Person',
    name: 'Maaike Groenewege',
    url: 'https://www.maaike.ai',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'GBP',
    availability: 'https://schema.org/InStock',
    validFrom: '2026-05-11T00:00:00+01:00',
    url: eventUrl,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const news = [
  {
    date: '30 May 2026',
    title: 'Oluwabusayo Omolabi on enterprise RAG',
    body: '<a href="https://www.linkedin.com/in/oluwabusayo-omolabi" target="_blank" rel="noopener">Oluwabusayo Omolabi</a> (AI Conversation Designer at Lloyds Banking Group) will open the day with a talk on behavioural guardrails, tone of voice, and response reliability when building RAG systems in regulated enterprise environments.',
  },
  {
    date: '27 May 2026',
    title: 'Marly Pierre-Louis joins the programme',
    body: '<a href="https://www.linkedin.com/in/marlypierrelouis" target="_blank" rel="noopener">Marly Pierre-Louis</a> will facilitate <em>Who gets to dream the machine?</em>: a flash book club exploring what speculative fiction can teach us about language, power, and the assumptions baked into the systems we design.',
  },
  {
    date: '22 May 2026',
    title: 'Linguist for a day announced',
    body: 'Two parallel tutorials by <a href="https://www.surrey.ac.uk/people/doris-dippold" target="_blank" rel="noopener">Doris Dippold</a> and <a href="https://www.ncl.ac.uk/elll/staff/profile/adambrandt.html" target="_blank" rel="noopener">Adam Brandt</a>. Group A applies rapport theory to user research and conversation design; Group B brings third position from conversation analysis to prompt design.',
  },
  {
    date: '11 May 2026',
    title: 'First contributors announced',
    body: '<a href="https://www.linkedin.com/in/romina-pankoke" target="_blank" rel="noopener">Romina Pankoke</a> and Maaike Groenewege will host an in-person Convoclub session on UX design in times of GenAI. We\'re building more and more complex applications through prompting and conversation. How do you design for your users if half of the time you have no idea what your agentic platform is up to?',
  },
  {
    date: '11 May 2026',
    title: 'Co-design the programme with us',
    body: 'Want to lead a session, do a portfolio review, or bring a topic? Let me know on the registration form.',
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://embed.lu.ma https://*.lu.ma; style-src 'self' 'unsafe-inline' https://embed.lu.ma https://*.lu.ma; img-src 'self' data: https:; frame-src https://luma.com https://*.lu.ma; connect-src 'self' https://*.lu.ma; font-src 'self' data: https://*.lu.ma;" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Maaike Groenewege" />
    <meta name="theme-color" content="#B01778" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://embed.lu.ma" />

    <!-- Open Graph -->
    <meta property="og:type" content="event" />
    <meta property="og:site_name" content="Convoclub" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Convoclub goes IRL — Wednesday 17 June 2026, University of Surrey, Guildford" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: schema.org Event -->
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
    <!-- Structured data: schema.org FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <header class="hero">
        <div class="container">
          <img
            id="convo-logo"
            class="logo"
            src="/images/convoclub-logo.png"
            alt="Convoclub"
            width="124"
            height="124"
            decoding="async"
          />
          <svg class="logo logo-fallback" viewBox="0 0 200 200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <!-- Cat head: pear-shaped silhouette with tall pointed ears, kawaii crescent eyes, small nose -->
            <path fill="#1A1A1A" d="M 100 32 C 90 32 82 38 76 52 L 60 96 C 50 110 36 118 36 138 C 36 168 64 184 100 184 C 136 184 164 168 164 138 C 164 118 150 110 140 96 L 124 52 C 118 38 110 32 100 32 Z"/>
            <path fill="#1A1A1A" d="M 56 110 L 44 30 L 92 84 Z"/>
            <path fill="#1A1A1A" d="M 144 110 L 156 30 L 108 84 Z"/>
            <path fill="#FFFFFF" d="M 78 116 a 10 13 0 1 0 0.01 0 Z"/>
            <path fill="#1A1A1A" d="M 73 122 a 10 13 0 1 0 0.01 0 Z"/>
            <path fill="#FFFFFF" d="M 122 116 a 10 13 0 1 0 0.01 0 Z"/>
            <path fill="#1A1A1A" d="M 117 122 a 10 13 0 1 0 0.01 0 Z"/>
            <path fill="#FFFFFF" d="M 92 142 Q 100 138 108 142 L 100 154 Z"/>
          </svg>
          <p class="kicker">Convoclub <span>IRL</span></p>
          <h1>Convoclub goes IRL</h1>
          <p class="event-date">Wednesday 17 June 2026</p>
          <p class="event-location">University of Surrey · Guildford</p>
          <a
            href={eventUrl}
            class="cta luma-checkout--button"
            data-luma-action="checkout"
            data-luma-event-id={eventId}
          >Register for this event</a>
          <p class="hero-note">Free · limited spots · Luma waitlist if we fill up</p>
        </div>
      </header>

      <section class="intro">
        <div class="container intro-grid">
          <div class="intro-main">
            <h2>Dear Convofriends, I'm so happy to announce that Convoclub is going IRL!</h2>
            <p>On Wednesday 17 June 2026, the day after the HUMIC symposium at the University of Surrey, we're hosting the very first Convoclub IRL: a casual, community-driven day for conversation designers, linguists, AI folks and anyone who loves language and the way humans (and machines) talk.</p>
            <p>This will be a day full of all the stuff that you always wish you could do at a conference, but never have time for: catching up with friends, getting to meet new people, spend time outside in a casual conversation and going beyond the hype & pitches to do some real learning.</p>
            <p class="pai-thanks">A massive thank you to the <a href="https://www.surrey.ac.uk/artificial-intelligence" target="_blank" rel="noopener">Surrey Institute for People-Centred AI (PAI)</a> for sponsoring this meetup and hosting us on the University of Surrey campus. Convoclub IRL would not be happening without them.</p>
            <aside class="callout">
              <p class="callout-heading">Attending HUMIC the day before?</p>
              <p>You can join us as a stand-alone event, or as an add-on to HUMIC the day before. Heads up: each event has its own registration page, so if you'd like to attend both, please register separately. You can register for HUMIC on <a href={humicUrl} target="_blank" rel="noopener">the University of Surrey website</a>.</p>
            </aside>

          </div>

          <aside class="news-side">
            <h2>Latest news</h2>
            <ul class="news-list">
              {news.map((item) => (
                <li>
                  <p class="news-date">{item.date}</p>
                  <p class="news-title">{item.title}</p>
                  <p class="news-body" set:html={item.body}></p>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </section>

      <section class="schedule">
        <div class="container medium">
          <p class="schedule-eyebrow">Wednesday 17 June 2026</p>
          <h2>Programme</h2>
          <p class="schedule-intro">Here's the shape of the day. A few talks are still TBA.</p>

          <ol class="blocks">
            <li>
              <span class="time">09:30–10:00</span>
              <div class="entry">
                <p class="entry-title">Reception & coffee</p>
              </div>
            </li>
            <li>
              <span class="time">10:00–10:15</span>
              <div class="entry">
                <p class="entry-title">Welcome</p>
                <p class="entry-who">Maaike Groenewege & Doris Dippold</p>
              </div>
            </li>
            <li>
              <span class="time">10:15–10:30</span>
              <div class="entry">
                <p class="entry-title">Welcome from the Surrey Institute for People-Centred AI (PAI)</p>
              </div>
            </li>
            <li>
              <span class="time">10:30–11:00</span>
              <details class="entry entry-expand">
                <summary>
                  <p class="entry-title">The realities of enterprise RAG</p>
                  <p class="entry-who">Oluwabusayo Omolabi</p>
                  <p class="entry-body">What it takes to ship RAG that behaves itself inside a regulated bank.</p>
                  <span class="entry-more"><span class="entry-more-show">Session details</span><span class="entry-more-hide">Hide details</span></span>
                </summary>
                <div class="entry-details">
                  <h4>About the session</h4>
                  <p>This session will explore the realities of building Retrieval-Augmented Generation (RAG) systems in enterprise environments, with a focus on behavioural guardrails, tone of voice adherence, and response reliability.</p>
                  <p>Busayo will discuss how teams define acceptable AI behaviour, manage retrieval quality, and design systems that remain trustworthy, compliant, and aligned with business expectations, drawing on practical challenges, approaches, and lessons learned from real-world conversational AI implementations.</p>
                  <h4>About Oluwabusayo</h4>
                  <p>Oluwabusayo Omolabi is an AI Conversation Designer at Lloyds Banking Group, where she architects large-scale, generative AI-powered conversational systems within one of the UK's most regulated industries. With over five years of experience in conversational AI, she specialises in designing intelligent, human-centred systems powered by LLMs, machine learning, and data-driven insight.</p>
                  <p>Beyond her corporate career, Busayo is a tech entrepreneur and ecosystem builder. A member of G100 mission million for Robotics, Automation and STEM and is the Co-founder and Director of iT8 Academy Ltd, a UK-registered tech academy, where she has trained and mentored aspiring professionals to successfully transition into technology careers.</p>
                </div>
              </details>
            </li>
            <li>
              <span class="time">11:00–12:30</span>
              <div class="entry">
                <p class="entry-title">Linguist for a day</p>
                <p class="entry-who">Doris Dippold & Adam Brandt</p>
                <details class="entry-group entry-expand">
                  <summary>
                    <span class="group-label"><strong>Group A:</strong> applying rapport theory to user research and conversation design (Doris Dippold)</span>
                    <span class="entry-more"><span class="entry-more-show">Session details</span><span class="entry-more-hide">Hide details</span></span>
                  </summary>
                  <div class="entry-details">
                    <h4>About the session</h4>
                    <p>What does it take to build conversational products that are empathetic to users' needs? In this interactive workshop, Doris Dippold will introduce her recently published taxonomy of human-machine rapport, benefiting conversation designers and their teams in user research, message design and user-led evaluation. Through hands-on exercises, you will learn to apply this taxonomy to interviews and survey responses of chatbot users and consider how you will apply the insights gained to prompt and fine-tune your system for rapport driven, empathetic responses. The workshop will end by discussing the opportunities and challenges of implementing rapport considerations in the conversation design workflow.</p>
                    <h4>About Doris</h4>
                    <p>Doris is an applied linguist passionate about the power of language and culture to shape how we think, speak, write and communicate with machines and one another. Her work spans research, teaching, and consultancy at the intersection of human AI interaction and intercultural communication. As part of her applied research, she works with public and private sector partners to bring insights from sociolinguistics and pragmatics insights into conversational AI. Doris is a Principal Fellow of the Surrey Institute for People Centred AI and a co-chair of the BAAL HUMALA Special Interest Group.</p>
                  </div>
                </details>
                <details class="entry-group entry-expand">
                  <summary>
                    <span class="group-label"><strong>Group B:</strong> third position in conversation analysis and prompt design (Adam Brandt)</span>
                    <span class="entry-more"><span class="entry-more-show">Session details</span><span class="entry-more-hide">Hide details</span></span>
                  </summary>
                  <div class="entry-details">
                    <h4>About the session</h4>
                    <p>In this interactive workshop, Adam Brandt will introduce the conversation analytic concept of 'third position': the turn in which an agent responds to a user's answer, and show how Conversation Analysis research on this can inform prompt design for chatbots and voice agents.</p>
                    <p>Through hands-on exercises, we will apply these insights to evaluate and improve agent responses, with a focus on making interactions more naturalistic and reducing unnecessary verbosity. We will end by discussing how third position thinking can be embedded practically in conversation design workflows.</p>
                  </div>
                </details>
              </div>
            </li>
            <li>
              <span class="time">12:30–13:15</span>
              <div class="entry">
                <p class="entry-title">Lunch</p>
              </div>
            </li>
            <li>
              <span class="time">13:15–13:45</span>
              <div class="entry">
                <p class="entry-title">Talk (speaker & topic TBA)</p>
              </div>
            </li>
            <li>
              <span class="time">13:45–14:45</span>
              <details class="entry entry-expand">
                <summary>
                  <p class="entry-title">Who gets to dream the machine?</p>
                  <p class="entry-who">Marly Pierre-Louis</p>
                  <p class="entry-body">A flash book club.</p>
                  <span class="entry-more"><span class="entry-more-show">Session details</span><span class="entry-more-hide">Hide details</span></span>
                </summary>
                <div class="entry-details">
                  <h4>About the session</h4>
                  <p>We design from assumption. What a 'natural' voice sounds like, what makes a chatbot feel helpful, whose language gets to be the default: these aren't neutral choices. They reflect who builds the systems and whose world gets treated as normative.</p>
                  <p>Speculative fiction writers have been sitting with hard questions about language, power, and non-human intelligence for decades. What can they teach us? And what might we design differently if we let their questions in?</p>
                  <h4>About Marly</h4>
                  <p>Marly Pierre-Louis is a UX Consultant based in Amsterdam. With 10+ years across e-commerce, fintech, and fem tech, her work spans experimentation, content operations, and LLM training. She helps teams practice good governance, judgment, craft, and care as AI reshapes how products are built. Alongside her consulting work, she is a speculative writer and community cultivator whose creative practice explores inner worlds, survival strategies, and spaces of possibility.</p>
                </div>
              </details>
            </li>
            <li>
              <span class="time">14:45–15:00</span>
              <div class="entry">
                <p class="entry-title">Coffee break</p>
              </div>
            </li>
            <li>
              <span class="time">15:00–15:15</span>
              <div class="entry">
                <p class="entry-title">Talk (speaker & topic TBA)</p>
              </div>
            </li>
            <li>
              <span class="time">15:15–16:15</span>
              <div class="entry">
                <p class="entry-title">Convoclub IRL session: UX design in times of GenAI (walk & talk)</p>
                <p class="entry-body">How do you design for your users if half of the time you have no idea what your agentic platform is up to?</p>
                <p class="entry-who">Maaike Groenewege & Romina Pankoke</p>
              </div>
            </li>
            <li>
              <span class="time">16:15–16:30</span>
              <div class="entry">
                <p class="entry-title">Wrap-up & close</p>
                <p class="entry-who">Maaike Groenewege & Doris Dippold</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="practical">
        <div class="container">
          <h2>Practical info</h2>
          <div class="cards">
            <article class="card">
              <p class="card-eyebrow">Location</p>
              <p class="card-body"><a href="https://www.surrey.ac.uk/" target="_blank" rel="noopener">University of Surrey</a>, Guildford campus. 35 minutes from London Waterloo. Hosted with the generous support of the <a href="https://www.surrey.ac.uk/artificial-intelligence" target="_blank" rel="noopener">Surrey Institute for People-Centred AI (PAI)</a>.</p>
              <p class="card-addr">Stag Hill, University Campus, Guildford GU2 7XH, United Kingdom</p>
              <p class="card-link"><a href="https://www.google.com/maps/search/?api=1&query=University+of+Surrey+Stag+Hill+Guildford+GU2+7XH" target="_blank" rel="noopener">View on Google Maps →</a></p>
            </article>
            <article class="card">
              <p class="card-eyebrow">Cost</p>
              <p class="card-body">Free. Spots are limited, so register early. If we fill up, the Luma waitlist will open and I'll release spots as they free up.</p>
            </article>
            <article class="card">
              <p class="card-eyebrow">Open to everyone</p>
              <p class="card-body">Convoclub members and curious newcomers alike. Not a member yet? Come hang out with us at <a href="https://convo.club" target="_blank" rel="noopener">convo.club</a>.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="register">
        <div class="container narrow">
          <h2>Reserve your spot</h2>
          <div class="embed-wrap">
            <iframe
              src={iframeSrc}
              width="100%"
              height="450"
              loading="lazy"
              frameborder="0"
              allow="fullscreen; payment"
              title="Convoclub IRL registration on Luma"
            ></iframe>
          </div>
          <p class="register-fallback">
            Embed not loading? <a href={eventUrl} target="_blank" rel="noopener">Open the event page on Luma</a>.
          </p>
        </div>
      </section>

      <section class="faq">
        <div class="container narrow">
          <h2>FAQs</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <footer class="signoff">
        <div class="container narrow">
          <p class="bye">Can't wait to meet you in real life again!</p>
          <p class="sig" lang="nl">Groetjes, Maaike 🌸</p>
          <p class="links">
            <a href="https://convo.club" target="_blank" rel="noopener">convo.club</a>
            <span aria-hidden="true">·</span>
            <a href="https://www.maaike.ai">maaike.ai</a>
          </p>
        </div>
      </footer>
    </main>

    <script>
      (function () {
        var img = document.getElementById('convo-logo');
        var fb = document.querySelector('.logo-fallback');
        if (!img || !fb) return;
        function swap() {
          if (img.naturalWidth === 0) {
            img.style.display = 'none';
            fb.style.display = 'block';
          }
        }
        if (img.complete) swap();
        else { img.addEventListener('load', swap); img.addEventListener('error', swap); }
      })();
    </script>
    <script id="luma-checkout" src="https://embed.lu.ma/checkout-button.js"></script>
    <script>
      (function () {
        var main = document.querySelector('.intro-main');
        var side = document.querySelector('.news-side');
        if (!main || !side) return;
        function sync() {
          // Only cap on desktop where the two sit side-by-side
          if (window.matchMedia('(max-width: 800px)').matches) {
            side.style.maxHeight = '';
            return;
          }
          side.style.maxHeight = main.offsetHeight + 'px';
        }
        sync();
        window.addEventListener('resize', sync);
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(sync).observe(main);
        }
      })();
    </script>

    <style is:global>
      :root {
        --fuchsia: #B01778;
        --fuchsia-deep: #7A0E55;
        --fuchsia-soft: #F8E6F0;
        --plum: #5B2A86;
        --plum-soft: #EFE6F6;
        --ink: #1A1A1A;
        --ink-soft: #4A4A4A;
        --paper: #FFFFFF;
        --rule: #EADCE3;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--fuchsia);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }
      a:hover { color: var(--fuchsia-deep); }

      /* Visible focus for keyboard users (WCAG 2.4.7) */
      :focus { outline: none; }
      :focus-visible {
        outline: 3px solid var(--fuchsia);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .hero :focus-visible {
        outline-color: var(--paper);
      }
      a.cta:focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 4px;
      }

      h1, h2, h3 { line-height: 1.15; margin: 0; letter-spacing: -0.01em; }

      main { display: block; }

      /* ---------- Skip link ---------- */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.6rem 1rem;
        text-decoration: none;
        font-weight: 700;
        z-index: 100;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        outline: 3px solid var(--paper);
      }

      /* ---------- Layout containers ---------- */
      .container {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 3rem);
        width: 100%;
      }
      .container.narrow { max-width: 820px; }
      .container.medium { max-width: 980px; }

      section, header.hero, footer.signoff {
        padding-block: clamp(3rem, 7vw, 5.5rem);
      }

      section h2 {
        font-size: clamp(1.6rem, 3.2vw, 2.1rem);
        font-weight: 800;
        margin-bottom: 1.75rem;
        color: var(--ink);
      }
      section h2::after {
        content: "";
        display: block;
        width: 36px;
        height: 3px;
        background: var(--fuchsia);
        margin-top: 0.85rem;
        border-radius: 2px;
      }

      /* ---------- Hero ---------- */
      .hero {
        background: var(--fuchsia);
        text-align: center;
        padding-block: clamp(2.25rem, 5vw, 3.75rem) clamp(2rem, 4vw, 3rem);
        color: var(--paper);
      }
      .hero .logo {
        width: clamp(96px, 11vw, 124px);
        height: clamp(96px, 11vw, 124px);
        margin-bottom: 1.75rem;
        display: inline-block;
        background: var(--paper);
        border-radius: 50%;
        padding: 14px;
        object-fit: contain;
      }
      .hero .logo-fallback { display: none; }
      .kicker {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--paper);
        opacity: 0.85;
        margin: 0 0 1.5rem;
      }
      .kicker span {
        color: var(--paper);
        opacity: 1;
      }
      .hero h1 {
        font-size: clamp(2.2rem, 5.5vw, 3.8rem);
        font-weight: 800;
        max-width: 16ch;
        margin: 0 auto 1.25rem;
        color: var(--paper);
      }
      .event-date {
        font-size: clamp(1.4rem, 2.6vw, 1.9rem);
        font-weight: 800;
        color: var(--paper);
        margin: 0 auto 0.4rem;
        letter-spacing: -0.005em;
      }
      .event-location {
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        color: var(--paper);
        opacity: 0.85;
        margin: 0 auto 2.5rem;
      }
      a.cta {
        display: inline-block !important;
        background: var(--paper) !important;
        color: var(--fuchsia-deep) !important;
        font-weight: 700 !important;
        font-size: clamp(1rem, 1.6vw, 1.1rem) !important;
        padding: 1rem 1.85rem !important;
        border: 0 !important;
        border-radius: 999px !important;
        text-decoration: none !important;
        line-height: 1.2 !important;
        letter-spacing: 0.01em !important;
        transition: background-color 160ms ease, color 160ms ease, transform 160ms ease !important;
      }
      a.cta:hover {
        background: var(--ink) !important;
        color: var(--paper) !important;
        transform: translateY(-1px);
      }
      a.cta:active {
        transform: translateY(0);
      }
      .hero-note {
        margin: 1.25rem 0 0;
        font-size: 0.9rem;
        color: var(--paper);
        opacity: 0.85;
      }

      /* ---------- Intro + news sidebar grid ---------- */
      .intro-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 5rem;
        align-items: start;
      }
      .intro-main { max-width: 720px; }

      .news-side {
        background: var(--fuchsia-soft);
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 1.5rem 1.4rem;
        display: flex;
        flex-direction: column;
        min-height: 0;
        max-height: 100%;
      }
      .news-side h2 {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--plum);
        margin: 0 0 1.25rem;
      }
      .news-side h2::after { display: none; }
      .news-list {
        list-style: none;
        padding: 0 0.5rem 0 0;
        margin: 0;
        overflow-y: auto;
        min-height: 0;
        flex: 1;
        scrollbar-width: thin;
        scrollbar-color: var(--fuchsia) transparent;
      }
      .news-list::-webkit-scrollbar { width: 6px; }
      .news-list::-webkit-scrollbar-thumb {
        background: var(--fuchsia);
        border-radius: 3px;
      }
      .news-list li {
        padding: 1rem 0;
        border-top: 1px solid var(--rule);
      }
      .news-list li:first-child { border-top: 0; padding-top: 0; }
      .news-list li:last-child { padding-bottom: 0; }
      .news-date {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--plum);
        margin: 0 0 0.35rem;
      }
      .news-title {
        font-size: 0.98rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 0.3rem;
        line-height: 1.3;
      }
      .news-body {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.88rem;
        line-height: 1.5;
      }

      /* ---------- Intro ---------- */
      .intro { background: var(--paper); }
      .intro .lead {
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 1.25rem;
      }
      .intro p { margin: 0 0 1.1rem; color: var(--ink); }
      .intro .pai-thanks {
        margin-top: 1.5rem;
        padding: 1rem 1.25rem;
        background: var(--fuchsia-soft);
        border-radius: 6px;
        font-size: 0.97rem;
        line-height: 1.55;
      }
      .callout {
        background: var(--plum-soft);
        border-left: 3px solid var(--plum);
        padding: 1.1rem 1.5rem;
        border-radius: 0 6px 6px 0;
        margin-top: 2rem;
      }
      .callout p { margin: 0; color: var(--ink); font-size: 0.97rem; }
      .callout .callout-heading {
        font-weight: 700;
        font-size: 1.02rem;
        color: var(--plum);
        margin: 0 0 0.5rem;
      }
      .callout a { color: var(--plum); }
      .callout a:hover { color: #3F1C5E; }

      /* ---------- Schedule ---------- */
      .schedule {
        background: var(--paper);
        position: relative;
      }
      .schedule-eyebrow {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--plum);
        margin: 0 0 0.6rem;
      }
      .schedule::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 64px;
        height: 2px;
        background: var(--fuchsia);
        border-radius: 2px;
        opacity: 0.5;
      }
      .schedule-intro,
      .schedule-outro {
        color: var(--ink-soft);
        font-size: 0.95rem;
      }
      .schedule-intro { margin: 0 0 1.25rem; }
      .schedule-outro { margin: 1.5rem 0 0; }

      .blocks {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .blocks li {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 0.25rem 1.5rem;
        align-items: baseline;
        padding: 0.75rem 0;
        border-top: 1px solid var(--rule);
      }
      .blocks li:last-child { border-bottom: 1px solid var(--rule); }

      .blocks .time {
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        color: var(--plum);
        white-space: nowrap;
        line-height: 1.4;
      }
      .blocks .entry-title {
        font-weight: 700;
        font-size: 0.98rem;
        color: var(--ink);
        margin: 0 0 0.15rem;
        line-height: 1.35;
      }
      .blocks .entry-body {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.9rem;
        line-height: 1.45;
      }
      .blocks .entry-who {
        margin: 0.15rem 0 0;
        color: var(--fuchsia);
        font-size: 0.88rem;
        font-style: italic;
        line-height: 1.4;
      }
      .blocks .entry-group {
        margin-top: 0.5rem;
        padding: 0.45rem 0;
        border-top: 1px dashed var(--rule);
      }
      .blocks .entry-group:first-of-type { border-top: 0; padding-top: 0.25rem; }
      .blocks .entry-group .group-label {
        display: block;
        color: var(--ink-soft);
        font-size: 0.9rem;
        line-height: 1.45;
      }
      .blocks details.entry-expand {
        padding: 0;
      }
      .blocks details.entry-expand summary {
        cursor: pointer;
        list-style: none;
        position: relative;
        padding-right: 7rem;
      }
      .blocks details.entry-expand summary::-webkit-details-marker { display: none; }
      .blocks .entry-more {
        position: absolute;
        top: 0;
        right: 0;
        display: inline-block;
        padding: 0.18rem 0.6rem;
        background: #F1ECEF;
        color: var(--ink-soft);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        border-radius: 999px;
        text-decoration: none;
        transition: background-color 160ms ease, color 160ms ease;
      }
      .blocks .entry-more-hide { display: none; }
      .blocks details.entry-expand[open] .entry-more-show { display: none; }
      .blocks details.entry-expand[open] .entry-more-hide { display: inline; }
      .blocks details.entry-expand summary:hover .entry-more {
        background: var(--fuchsia-soft);
        color: var(--fuchsia-deep);
      }
      .blocks .entry-details {
        margin-top: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px dashed var(--rule);
      }
      .blocks .entry-details h4 {
        margin: 0.75rem 0 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--plum);
      }
      .blocks .entry-details h4:first-child { margin-top: 0; }
      .blocks .entry-details p {
        margin: 0 0 0.7rem;
        color: var(--ink);
        font-size: 0.92rem;
        line-height: 1.55;
      }
      .blocks .entry-details p:last-child { margin-bottom: 0; }

      /* ---------- Practical ---------- */
      .practical { background: var(--fuchsia-soft); }
      .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }
      .card {
        background: var(--paper);
        border: 1px solid var(--rule);
        border-top: 3px solid var(--fuchsia);
        border-radius: 6px;
        padding: 1.5rem 1.5rem 1.75rem;
      }
      .card-eyebrow {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--plum);
        margin: 0 0 0.6rem;
      }
      .card-body {
        margin: 0 0 0.85rem;
        color: var(--ink);
        font-size: 0.97rem;
      }
      .card-addr {
        margin: 0 0 0.85rem;
        font-size: 0.85rem;
        color: var(--ink-soft);
        font-style: italic;
      }
      .card-link {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 600;
      }
      .card-link a { text-decoration: none; }
      .card-link a:hover { text-decoration: underline; }

      /* ---------- FAQ ---------- */
      .faq { background: var(--paper); }
      .faq-list {
        display: grid;
        gap: 0.5rem;
      }
      .faq-item {
        border-top: 1px solid var(--rule);
        padding: 0.25rem 0;
      }
      .faq-item:last-child { border-bottom: 1px solid var(--rule); }
      .faq-item summary {
        cursor: pointer;
        list-style: none;
        font-weight: 700;
        font-size: 1rem;
        color: var(--ink);
        padding: 0.85rem 2rem 0.85rem 0;
        position: relative;
        min-height: 44px;
        display: flex;
        align-items: center;
      }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after {
        content: "+";
        position: absolute;
        right: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 400;
        font-size: 1.4rem;
        color: var(--fuchsia);
        line-height: 1;
        transition: transform 160ms ease;
      }
      .faq-item[open] summary::after {
        content: "−";
      }
      .faq-item p {
        margin: 0 0 1rem;
        color: var(--ink-soft);
        font-size: 0.95rem;
        line-height: 1.55;
        max-width: 60ch;
      }

      /* ---------- Register ---------- */
      .register {
        background: var(--paper);
        text-align: center;
      }
      .register h2 { display: inline-block; text-align: left; }
      .embed-wrap {
        margin: 0.5rem auto 0;
        max-width: 600px;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 0.75rem;
      }
      .embed-wrap iframe {
        display: block;
        width: 100%;
        max-width: 100%;
        border: 0 !important;
        border-radius: 4px;
      }
      .register-fallback {
        margin-top: 1.25rem;
        font-size: 0.92rem;
        color: var(--ink-soft);
      }

      /* ---------- Signoff ---------- */
      .signoff {
        text-align: center;
        background: var(--paper);
        border-top: 1px solid var(--rule);
      }
      .bye {
        font-size: clamp(1.2rem, 2.6vw, 1.55rem);
        font-weight: 700;
        margin: 0 0 0.45rem;
        color: var(--ink);
      }
      .sig {
        font-size: 1.05rem;
        color: var(--ink-soft);
        margin: 0 0 1.75rem;
      }
      .links {
        font-size: 0.92rem;
        color: var(--ink-soft);
        margin: 0;
      }
      .links span {
        margin: 0 0.55em;
        color: var(--rule);
      }
      .links a { color: var(--plum); text-decoration: none; }
      .links a:hover { color: var(--fuchsia-deep); text-decoration: underline; }

      /* ---------- Responsive ---------- */
      @media (max-width: 800px) {
        .cards { grid-template-columns: 1fr; }
        .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      }
      @media (max-width: 560px) {
        .blocks li {
          grid-template-columns: 1fr;
          gap: 0.4rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        a.cta { transition: none !important; }
        a.cta:hover { transform: none; }
      }
    </style>
  </body>
</html>
