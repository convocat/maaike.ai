---
/**
 * /research/map — concept map.
 *
 * Placeholder per spec — prototype uses hand-placed coordinates in data.js;
 * production integration with the existing /graph is deferred
 * (see README § What is still out of scope).
 */
import ResearchLayout from '../../layouts/ResearchLayout.astro';
---

<ResearchLayout title="Map" view="graph">
  <div class="map-view">
    <div class="map-head">
      <h1 class="map-title">Map</h1>
      <p class="map-sub">A force-directed view of your topics and their typed relations is in development.</p>
    </div>

    <div class="map-stage">
      <div class="map-placeholder">
        <svg width="280" height="180" viewBox="0 0 280 180" fill="none" stroke="var(--ink-3)" stroke-width="0.75" opacity="0.6">
          <circle cx="140" cy="90" r="6" fill="var(--accent)" stroke="none"/>
          <circle cx="60" cy="40" r="4"/><line x1="140" y1="90" x2="60" y2="40"/>
          <circle cx="230" cy="50" r="4"/><line x1="140" y1="90" x2="230" y2="50"/>
          <circle cx="80" cy="140" r="4"/><line x1="140" y1="90" x2="80" y2="140"/>
          <circle cx="220" cy="140" r="4"/><line x1="140" y1="90" x2="220" y2="140"/>
          <circle cx="30" cy="95" r="3"/><line x1="60" y1="40" x2="30" y2="95"/>
          <circle cx="250" cy="100" r="3"/><line x1="230" y1="50" x2="250" y2="100"/>
        </svg>
        <p class="map-placeholder-text">
          Existing graph lives at <a href="/graph">/graph</a>.
          This view will layer the research wiki's interactions on top of that data.
        </p>
      </div>
    </div>
  </div>

  <div slot="rightRail" class="rail-r-inner">
    <div class="rail-r-section">
      <div class="rail-r-label">About the map</div>
      <p class="rail-r-body">A force-directed layout is planned. Positions will persist so returning to a topic finds it where you left it.</p>
    </div>
  </div>
</ResearchLayout>
