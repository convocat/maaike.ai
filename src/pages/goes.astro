---
import PageLayout from '../layouts/PageLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

// ─────────────────────────────────────────────────────────────────────────────
//  EDIT THESE TWO THINGS  (everything else is automatic)
// ─────────────────────────────────────────────────────────────────────────────

//  1. Page title + intro shown at the top of the page.
const PAGE_TITLE = 'Prompten voor de Raad';
const PAGE_INTRO = 'Materiaal om te downloaden. Pak de bestanden hieronder, of open de volledige map in Google Drive.';

//  2. Your Google Drive folder link.
//     Paste the share link here (make sure it is shared as "Anyone with the link").
//     Leave it as an empty string ('') to hide the Drive button entirely.
const DRIVE_URL = 'https://drive.google.com/drive/folders/1L_1Xtr4voeQxyqAjsWSCeQX4UqN79cEJ?usp=sharing';
const DRIVE_LABEL = 'Open de volledige map in Google Drive';

// ─────────────────────────────────────────────────────────────────────────────
//  HOW TO ADD A DOWNLOAD:
//  Drop any file into the  public/goes/  folder, then run publish.bat.
//  It appears below automatically — no editing needed.
// ─────────────────────────────────────────────────────────────────────────────

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const filesDir = path.join(__dirname, '..', '..', 'public', 'goes');

function humanSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  const units = ['KB', 'MB', 'GB'];
  let value = bytes / 1024;
  let i = 0;
  while (value >= 1024 && i < units.length - 1) {
    value /= 1024;
    i++;
  }
  return `${value < 10 ? value.toFixed(1) : Math.round(value)} ${units[i]}`;
}

const ICONS: Record<string, string> = {
  pdf: '📕', doc: '📘', docx: '📘', ppt: '📙', pptx: '📙',
  xls: '📗', xlsx: '📗', csv: '📗',
  png: '🖼️', jpg: '🖼️', jpeg: '🖼️', gif: '🖼️', svg: '🖼️', webp: '🖼️',
  zip: '🗂️', mp3: '🎵', mp4: '🎬', mov: '🎬',
  txt: '📄', md: '📄',
};

// Files that should never show up as downloads.
const HIDDEN = new Set(['.gitkeep', '.ds_store', 'readme.md', 'thumbs.db']);

let files: { name: string; href: string; size: string; ext: string; icon: string }[] = [];

if (fs.existsSync(filesDir)) {
  files = fs
    .readdirSync(filesDir)
    .filter((name) => {
      if (name.startsWith('.')) return false;
      if (HIDDEN.has(name.toLowerCase())) return false;
      return fs.statSync(path.join(filesDir, name)).isFile();
    })
    .map((name) => {
      const ext = path.extname(name).slice(1).toLowerCase();
      const stat = fs.statSync(path.join(filesDir, name));
      return {
        name,
        href: `/goes/${encodeURIComponent(name)}`,
        size: humanSize(stat.size),
        ext: ext.toUpperCase(),
        icon: ICONS[ext] || '📎',
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
}
---

<PageLayout title={PAGE_TITLE} description={PAGE_INTRO}>
  <div class="goes-page">
    <h1>{PAGE_TITLE}</h1>
    <p class="intro">{PAGE_INTRO}</p>

    {DRIVE_URL && (
      <a class="drive-button" href={DRIVE_URL} target="_blank" rel="noopener noreferrer">
        <span class="drive-icon" aria-hidden="true">📁</span>
        {DRIVE_LABEL}
      </a>
    )}

    {files.length === 0 ? (
      <p class="empty">
        Er staan nog geen bestanden klaar om te downloaden.
      </p>
    ) : (
      <ul class="file-list">
        {files.map((f) => (
          <li>
            <a class="file-card" href={f.href} download>
              <span class="file-icon" aria-hidden="true">{f.icon}</span>
              <span class="file-meta">
                <span class="file-name">{f.name}</span>
                <span class="file-sub">{f.ext} · {f.size}</span>
              </span>
              <span class="file-action" aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</PageLayout>

<style>
  .goes-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-lg) 0 var(--space-2xl);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    margin-bottom: var(--space-xs);
  }

  .intro {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .drive-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    margin-bottom: var(--space-2xl);
    border-radius: 8px;
    background: var(--color-accent);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: filter 150ms, transform 150ms;
  }
  .drive-button:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .drive-icon { font-size: 1.1rem; }

  .empty {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-align: center;
    padding: var(--space-2xl);
    line-height: 1.7;
  }
  .empty code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--color-bg-card);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .file-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 150ms, background 150ms, transform 150ms;
  }
  .file-card:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-card);
    transform: translateY(-1px);
  }

  .file-icon { font-size: 1.5rem; line-height: 1; flex-shrink: 0; }

  .file-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }
  .file-name {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    overflow-wrap: anywhere;
  }
  .file-sub {
    font-size: 0.74rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .file-action {
    flex-shrink: 0;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    transition: color 150ms, transform 150ms;
  }
  .file-card:hover .file-action {
    color: var(--color-accent);
    transform: translateY(2px);
  }
</style>
