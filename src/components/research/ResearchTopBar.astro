---
/**
 * Research topbar — sits inside `.center`, holds breadcrumbs + search + view toggle.
 * Matches prototype TopBar (app.jsx:126).
 */
interface Props {
  view: string;
  noteTitle?: string;
}
const { view, noteTitle = 'Topic' } = Astro.props;

type Crumb = [string, boolean];
let crumbs: Crumb[];
if (view === 'home')        crumbs = [['Research', false], ['Dashboard', true]];
else if (view === 'read')   crumbs = [['Concepts', false], [noteTitle, true]];
else if (view === 'graph')  crumbs = [['Research', false], ['Map', true]];
else if (view === 'log')    crumbs = [['Research', false], ["Today's log", true]];
else if (view === 'stream') crumbs = [['Research', false], ['Stream', true]];
else if (view === 'ask')    crumbs = [['Research', false], ['Ask', true]];
else                        crumbs = [['Research', false], [view, true]];

const tabs: Array<[string, string, string]> = [
  ['home',   'Dashboard', '/research/'],
  ['ask',    'Ask',       '/research/ask'],
  ['stream', 'Stream',    '/research/stream'],
  ['graph',  'Map',       '/research/map'],
  ['log',    'Log',       '/research/log'],
];
---

<div class="topbar">
  <div class="crumbs">
    {crumbs.map((c, i) => (
      <>
        {i > 0 && <span class="sep">/</span>}
        <span class={c[1] ? 'here' : ''}>{c[0]}</span>
      </>
    ))}
  </div>
  <div class="top-tools">
    <div class="search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:var(--ink-3)">
        <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
      </svg>
      <input placeholder="Search concepts, people, entities…" />
      <span class="kbd">⌘K</span>
    </div>
    <div class="view-toggle">
      {tabs.map(([id, label, href]) => (
        <a data-active={view === id ? 'true' : 'false'} href={href}>{label}</a>
      ))}
    </div>
  </div>
</div>
