---
/**
 * Research left rail — brand + nav (collections + pinned) + footer.
 * Matches prototype LeftRail (app.jsx:33).
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  view: string;
}
const { view: _view } = Astro.props;

// Load real topics from triples.json
const triplesPath = path.resolve('src/data/triples.json');
let topics: Record<string, any> = {};
let topicCount = 0;
try {
  const raw = JSON.parse(fs.readFileSync(triplesPath, 'utf-8'));
  topics = raw.topics || {};
  topicCount = Object.keys(topics).length;
} catch (_) {}

// Group by type
const collections: Record<string, Array<{ id: string; title: string }>> = {
  Concepts: [],
  People: [],
  Entities: [],
};
for (const [slug, t] of Object.entries(topics) as [string, any][]) {
  const type = (t.type || '').toLowerCase();
  const entry = { id: slug, title: t.label || slug };
  if (type === 'person') collections.People.push(entry);
  else if (type === 'technology' || type === 'mechanism') collections.Entities.push(entry);
  else collections.Concepts.push(entry);
}
for (const k of Object.keys(collections)) collections[k].sort((a, b) => a.title.localeCompare(b.title));
---

<aside class="rail-l">
  <div class="brand">
    <div class="brand-mark"><img src="/images/watercolor-leaf-trimmed.png" alt="" width="38" height="48"/></div>
    <div>
      <div class="brand-name">Maai & AI <em>wiki</em></div>
      <div class="brand-sub">research assistant</div>
    </div>
  </div>

  <nav class="nav">
    <div class="nav-group">
      <div class="nav-label">Research</div>
      <a class="nav-item" href="/research/" data-active={_view === 'home' ? 'true' : 'false'}>
        <span class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg></span>
        <span class="label-text">Dashboard</span>
      </a>
      <a class="nav-item" href="/research/ask" data-active={_view === 'ask' ? 'true' : 'false'}>
        <span class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></span>
        <span class="label-text">Ask the wiki</span>
        <span class="badge">chat</span>
      </a>
      <a class="nav-item" href="/research/stream" data-active={_view === 'stream' ? 'true' : 'false'}>
        <span class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1"/><path d="M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"/></svg></span>
        <span class="label-text">Stream</span>
      </a>
      <a class="nav-item" href="/research/map" data-active={_view === 'graph' ? 'true' : 'false'}>
        <span class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="M9 11l-3-3M15 11l3-3M9 13l-3 3M15 13l3 3"/></svg></span>
        <span class="label-text">Map</span>
      </a>
      <a class="nav-item" href="/research/log" data-active={_view === 'log' ? 'true' : 'false'}>
        <span class="ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
        <span class="label-text">Today's log</span>
      </a>
    </div>

    <div class="nav-group">
      <div class="nav-label">Pinned</div>
      <ul class="nav-coll-list" id="pinned-list">
        <li><span class="nav-coll-topic nav-coll-empty">No pins yet.</span></li>
      </ul>
    </div>

    {Object.entries(collections).map(([name, items]) => (
      <div class="nav-group">
        <div class="nav-label">
          <span>{name}</span>
          <span class="nav-label-count">{items.length}</span>
        </div>
        <ul class="nav-flat-list">
          {items.slice(0, 12).map(it => (
            <li><a class="nav-flat-item" href={`/research/${it.id}`}>{it.title}</a></li>
          ))}
          {items.length > 12 && (
            <li><a class="nav-flat-more" href={`/research/?browse=${encodeURIComponent(name.toLowerCase())}`}>Browse all {items.length} →</a></li>
          )}
        </ul>
      </div>
    ))}
  </nav>

  <div class="rail-foot">
    <div class="avatar">M</div>
    <div>
      <div style="color:var(--ink-2)">Maaike</div>
      <div>{topicCount} topics · research mode</div>
    </div>
  </div>
</aside>

<script>
  // Expand/collapse collections — toggle siblings via data-open
  document.querySelectorAll<HTMLButtonElement>('.nav-coll-head').forEach(btn => {
    btn.addEventListener('click', () => {
      const coll = btn.closest('.nav-coll') as HTMLElement;
      if (!coll) return;
      const open = coll.getAttribute('data-open') === 'true';
      coll.setAttribute('data-open', open ? 'false' : 'true');
      btn.setAttribute('aria-expanded', (!open).toString());
      const body = coll.querySelector<HTMLElement>('.nav-coll-body');
      if (body) body.hidden = open;
    });
  });

  // Restore pinned
  try {
    const pins = JSON.parse(localStorage.getItem('rw:pinned') || '[]');
    const list = document.getElementById('pinned-list');
    if (list && pins.length) {
      list.innerHTML = pins.map((p: any) =>
        `<li><a class="nav-coll-topic" href="/research/${p.slug}"><span class="nav-coll-title">${p.label}</span></a></li>`
      ).join('');
    }
  } catch (e) {}
</script>
