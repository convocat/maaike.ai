---
import settings from '../data/settings.json';
import CollectionIcon from './CollectionIcon.astro';

const collections = [
  { href: '/articles', slug: 'articles', label: 'Articles', desc: settings.articlesDescription },
  { href: '/field-notes', slug: 'field-notes', label: 'Field Notes', desc: settings.fieldNotesDescription },
  { href: '/seeds', slug: 'seeds', label: 'Seeds', desc: settings.seedsDescription },
  { href: '/jottings', slug: 'jottings', label: 'Jottings', desc: settings.jottingsDescription },
  { href: '/weblinks', slug: 'weblinks', label: 'Weblinks', desc: settings.weblinksDescription },
  { href: '/videos', slug: 'videos', label: 'Videos', desc: settings.videosDescription },
  { href: '/experiments', slug: 'experiments', label: 'Experiments', desc: settings.experimentsDescription },
  { href: '/library', slug: 'library', label: 'Library', desc: settings.libraryDescription },
  { href: '/projects', slug: 'projects', label: 'Projects', desc: 'Active and completed projects.' },
];

const navLinks = [
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-title">
      {settings.siteTitle}
    </a>

    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul>
        <li class="garden-dropdown">
          <button class="garden-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
            The Garden
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M1 1 L5 5 L9 1" />
            </svg>
          </button>
          <div class="garden-mega-menu">
            <div class="mega-collections">
              {collections.map(({ href, slug, label, desc }) => (
                <a href={href} class:list={['mega-item', { active: currentPath.startsWith(href) }]}>
                  <CollectionIcon collection={slug} size={20} />
                  <div>
                    <span class="mega-label">{label}</span>
                    <span class="mega-desc">{desc}</span>
                  </div>
                </a>
              ))}
            </div>
            <div class="mega-views">
              <a href="/" class:list={[{ active: currentPath === '/' }]}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="15" y2="12" /><line x1="3" y1="18" x2="18" y2="18" /></svg>
                Stream
              </a>
              <a href="/explore" class:list={[{ active: currentPath.startsWith('/explore') }]}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36z" /></svg>
                Map
              </a>
              <a href="/collections" class:list={[{ active: currentPath === '/collections' }]}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
                Collections
              </a>

              <a href="/graph" class:list={[{ active: currentPath === '/graph' }]}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="7" y1="7.5" x2="11" y2="16.5"/><line x1="17" y1="7.5" x2="13" y2="16.5"/></svg>
                Graph
              </a>
              <a href="/compost" class:list={[{ active: currentPath === '/compost' }]}>
                <span aria-hidden="true" style="font-size:15px;line-height:1">🍂</span>
                Compost
              </a>
            </div>
          </div>
        </li>
        <li class="toolshed-dropdown">
          <button class="toolshed-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
            Toolshed
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M1 1 L5 5 L9 1" />
            </svg>
          </button>
          <div class="toolshed-mega-menu">
            <a href="/toolshed" class:list={['toolshed-mega-item', { active: currentPath === '/toolshed' }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
              <div>
                <span class="toolshed-mega-label">Garden ops</span>
                <span class="toolshed-mega-desc">Backlog, health, release notes</span>
              </div>
            </a>
            <a href="/toolshed/design" class:list={['toolshed-mega-item', { active: currentPath.startsWith('/toolshed/design') }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M3 12h3m12 0h3M12 3v3m0 12v3" /><path d="M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" /></svg>
              <div>
                <span class="toolshed-mega-label">Visual design</span>
                <span class="toolshed-mega-desc">Tokens, components, interactions</span>
              </div>
            </a>
            <a href="/toolshed/technical" class:list={['toolshed-mega-item', { active: currentPath.startsWith('/toolshed/technical') }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
              <div>
                <span class="toolshed-mega-label">Tech specs</span>
                <span class="toolshed-mega-desc">Architecture, schemas, deployment</span>
              </div>
            </a>
          </div>
        </li>
        {navLinks.map(({ href, label }) => (
          <li>
            <a href={href} class:list={[{ active: href !== '/' && currentPath.startsWith(href) }]}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="font-picker">
      <button class="font-picker-btn" id="font-picker-btn" aria-label="Reading font" aria-expanded="false" aria-controls="font-picker-menu" title="Reading font">
        <span class="font-picker-letter">A</span><span class="font-picker-letter font-picker-letter--small">a</span>
      </button>
      <div class="font-picker-menu" id="font-picker-menu" role="menu" hidden>
        <span class="font-picker-label">Reading font</span>
        <button type="button" class="font-picker-option" role="menuitemradio" data-font="default">
          <span class="font-picker-name" style="font-family: 'Roboto', sans-serif">Roboto</span>
          <span class="font-picker-meta">Default</span>
        </button>
        <button type="button" class="font-picker-option" role="menuitemradio" data-font="mulish">
          <span class="font-picker-name" style="font-family: 'Mulish', sans-serif">Mulish</span>
          <span class="font-picker-meta">Soft humanist</span>
        </button>
        <button type="button" class="font-picker-option" role="menuitemradio" data-font="nunito">
          <span class="font-picker-name" style="font-family: 'Nunito', sans-serif">Nunito</span>
          <span class="font-picker-meta">Rounded warm</span>
        </button>
        <button type="button" class="font-picker-option" role="menuitemradio" data-font="atkinson">
          <span class="font-picker-name" style="font-family: 'Atkinson Hyperlegible', sans-serif">Atkinson Hyperlegible</span>
          <span class="font-picker-meta">Accessibility-first</span>
        </button>
      </div>
    </div>

    <a href="/explore" class="header-search-btn" aria-label="Explore the garden" title="Explore the garden">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36z"/>
      </svg>
    </a>

  </div>
</header>

<script>
  function setupMenu() {
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.getElementById('site-nav');
    if (!toggle || !nav) return;

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('open');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (nav.classList.contains('open') && !nav.contains(e.target as Node) && e.target !== toggle && !toggle.contains(e.target as Node)) {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function setupGardenDropdown() {
    const trigger = document.querySelector('.garden-dropdown-trigger') as HTMLButtonElement;
    const dropdown = document.querySelector('.garden-dropdown') as HTMLElement;
    if (!trigger || !dropdown) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      dropdown.classList.toggle('open');
    });

    const menuToggle = document.querySelector('.menu-toggle');
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !menuToggle?.contains(e.target as Node)) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown.classList.contains('open')) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('open');
        trigger.focus();
      }
    });
  }

  function setupToolshedDropdown() {
    const trigger = document.querySelector('.toolshed-dropdown-trigger') as HTMLButtonElement;
    const dropdown = document.querySelector('.toolshed-dropdown') as HTMLElement;
    if (!trigger || !dropdown) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      dropdown.classList.toggle('open');
    });

    const menuToggle = document.querySelector('.menu-toggle');
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !menuToggle?.contains(e.target as Node)) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown.classList.contains('open')) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('open');
        trigger.focus();
      }
    });
  }

  function setupFontPicker() {
    const btn = document.getElementById('font-picker-btn');
    const menu = document.getElementById('font-picker-menu');
    if (!btn || !menu) return;

    const updateChecked = () => {
      const current = document.documentElement.getAttribute('data-font') || 'default';
      menu.querySelectorAll<HTMLButtonElement>('.font-picker-option').forEach((opt) => {
        const isSelected = opt.dataset.font === current;
        opt.setAttribute('aria-checked', String(isSelected));
        opt.classList.toggle('is-selected', isSelected);
      });
    };

    const open = () => {
      menu.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      updateChecked();
    };
    const close = () => {
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (menu.hidden) open();
      else close();
    });

    menu.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.font-picker-option') as HTMLButtonElement | null;
      if (!target) return;
      const font = target.dataset.font || 'default';
      if (font === 'default') {
        document.documentElement.removeAttribute('data-font');
        try { localStorage.removeItem('garden-body-font'); } catch {}
      } else {
        document.documentElement.setAttribute('data-font', font);
        try { localStorage.setItem('garden-body-font', font); } catch {}
      }
      updateChecked();
      close();
    });

    document.addEventListener('click', (e) => {
      if (menu.hidden) return;
      const target = e.target as Node | null;
      if (target && (menu.contains(target) || btn.contains(target))) return;
      close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        close();
        btn.focus();
      }
    });

    updateChecked();
  }

  setupMenu();
  setupGardenDropdown();
  setupToolshedDropdown();
  setupFontPicker();
  document.addEventListener('astro:after-swap', () => { setupMenu(); setupGardenDropdown(); setupToolshedDropdown(); setupFontPicker(); });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-md);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .site-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-heading);
    text-decoration: none;
    white-space: nowrap;
    padding: var(--space-xs) 0;
  }
  .site-title:hover {
    color: var(--color-accent);
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    list-style: none;
    padding: 0;
    gap: var(--space-lg);
    align-items: center;
  }

  .site-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .site-nav a:hover,
  .site-nav a.active {
    color: var(--color-accent);
  }

  /* Garden mega dropdown */
  .garden-dropdown {
    position: relative;
  }
  .garden-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .garden-dropdown-trigger:hover {
    color: var(--color-accent);
  }
  .garden-dropdown-trigger .chevron {
    transition: transform var(--transition-fast);
  }
  .garden-dropdown.open .garden-dropdown-trigger .chevron {
    transform: rotate(180deg);
  }

  .garden-mega-menu {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    right: -100px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-lg);
    width: 520px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    z-index: 200;
  }
  .garden-dropdown.open .garden-mega-menu {
    display: block;
  }

  .mega-collections {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
  }

  .mega-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-radius: 8px;
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .mega-item:hover {
    background: var(--color-bg-card);
  }
  .mega-item div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mega-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-heading);
  }
  .mega-item:hover .mega-label {
    color: var(--color-accent);
  }
  .mega-item.active .mega-label {
    color: var(--color-accent);
  }
  .mega-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    white-space: normal;
  }

  .mega-views {
    display: flex;
    gap: var(--space-md);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
  }
  .mega-views a {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    border-radius: 6px;
    transition: all var(--transition-fast);
  }
  .mega-views a:hover {
    color: var(--color-accent);
    background: var(--color-bg-card);
  }
  .mega-views a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Font picker */
  .font-picker {
    position: relative;
  }
  .font-picker-btn {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1px;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 10px;
    margin: -8px;
    border-radius: 50%;
    min-width: 36px;
    min-height: 36px;
    transition: color 0.15s, background 0.15s;
    font-family: inherit;
  }
  .font-picker-btn:hover {
    color: var(--color-accent);
    background: var(--color-border);
  }
  .font-picker-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .font-picker-letter {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1;
    font-weight: 600;
  }
  .font-picker-letter--small { font-size: 0.7rem; }

  .font-picker-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: -4px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-sm);
    width: 240px;
    box-shadow: 0 8px 30px var(--color-shadow);
    z-index: 200;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .font-picker-menu[hidden] { display: none; }
  .font-picker-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding: var(--space-xs) var(--space-sm) var(--space-xs);
  }
  .font-picker-option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    padding: var(--space-xs) var(--space-sm);
    border-radius: 6px;
    color: var(--color-text);
    font: inherit;
    transition: background 0.15s;
  }
  .font-picker-option:hover { background: var(--color-bg-card); }
  .font-picker-option.is-selected {
    background: var(--color-tag-bg);
  }
  .font-picker-name {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .font-picker-meta {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .header-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    padding: 8px;
    margin: -8px;
    border-radius: 50%;
    transition: color 0.15s, background 0.15s;
    flex-shrink: 0;
  }
  .header-search-btn:hover {
    color: var(--color-accent);
    background: var(--color-border);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 10px;
    margin: -10px;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
  }

  /* Toolshed dropdown */
  .toolshed-dropdown {
    position: relative;
  }
  .toolshed-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-text-muted);
    padding: 0;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .toolshed-dropdown-trigger:hover {
    color: var(--color-accent);
  }
  .toolshed-dropdown-trigger .chevron {
    transition: transform var(--transition-fast);
  }
  .toolshed-dropdown.open .toolshed-dropdown-trigger .chevron {
    transform: rotate(180deg);
  }

  .toolshed-mega-menu {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-md);
    width: 260px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    z-index: 200;
    display: none;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .toolshed-dropdown.open .toolshed-mega-menu {
    display: flex;
  }

  .toolshed-mega-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-radius: 8px;
    text-decoration: none;
    transition: background var(--transition-fast);
    color: var(--color-text-muted);
  }
  .toolshed-mega-item:hover {
    background: var(--color-bg-card);
  }
  .toolshed-mega-item svg {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--color-text-muted);
  }
  .toolshed-mega-item div {
    display: flex;
    flex-direction: column;
