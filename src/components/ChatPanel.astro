---
/**
 * ChatPanel
 *
 * Floating "Ask" button in the bottom-right plus a slide-in drawer on the
 * right (full-screen on mobile). The drawer is resizable from its left edge
 * and has a maximize toggle. Conversation persists across navigation via
 * sessionStorage; pane width and maximized state via localStorage.
 *
 * Page-specific context (slug, collection, title, frontmatter metadata) is
 * read from <script id="page-context" type="application/json"> written by
 * BaseLayout.astro and sent with every request. The API loads the post body
 * server-side from src/content using the slug and collection.
 */
---

<aside id="chat-panel" class="chat-panel" aria-label="Garden chat">
  <button
    type="button"
    id="chat-toggle"
    class="chat-toggle"
    aria-controls="chat-drawer"
    aria-expanded="false"
    aria-label="Open chat"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
    <span class="chat-toggle-label">Ask</span>
  </button>

  <div
    id="chat-drawer"
    class="chat-drawer"
    role="dialog"
    aria-modal="false"
    aria-labelledby="chat-drawer-title"
    aria-hidden="true"
    hidden
  >
    <div id="chat-resize" class="chat-resize" role="separator" aria-orientation="vertical" aria-label="Resize panel" tabindex="0"></div>

    <header class="chat-header">
      <div class="chat-header-titles">
        <h2 id="chat-drawer-title" class="chat-header-title">Talk about this page</h2>
        <p class="chat-header-context" id="chat-context-pill">Loading…</p>
      </div>
      <div class="chat-header-actions">
        <button type="button" id="chat-settings-toggle" class="chat-icon-btn" aria-label="Settings" title="Settings" aria-expanded="false" aria-controls="chat-settings-panel" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
        </button>
        <button type="button" id="chat-reset" class="chat-icon-btn" aria-label="Start a new conversation" title="Reset conversation">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 4 1 10 7 10" />
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
          </svg>
        </button>
        <button type="button" id="chat-maximize" class="chat-icon-btn" aria-label="Maximize panel" title="Maximize">
          <svg class="icon-maximize" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 3 21 3 21 9" />
            <polyline points="9 21 3 21 3 15" />
            <line x1="21" y1="3" x2="14" y2="10" />
            <line x1="3" y1="21" x2="10" y2="14" />
          </svg>
          <svg class="icon-restore" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 14 10 14 10 20" />
            <polyline points="20 10 14 10 14 4" />
            <line x1="14" y1="10" x2="21" y2="3" />
            <line x1="3" y1="21" x2="10" y2="14" />
          </svg>
        </button>
        <button type="button" id="chat-close" class="chat-icon-btn" aria-label="Close chat" title="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <div id="chat-settings-panel" class="chat-settings-popover" role="menu" hidden>
        <label class="chat-settings-label" for="chat-prompt-select">System prompt</label>
        <select id="chat-prompt-select" class="chat-settings-select" aria-label="Select system prompt"></select>
        <p class="chat-settings-hint">Switching clears the current conversation.</p>
      </div>
    </header>

    <div class="chat-history" id="chat-history" role="log" aria-live="polite"></div>

    <form class="chat-form" id="chat-form" autocomplete="off">
      <textarea
        id="chat-input"
        class="chat-input"
        placeholder="Ask about this page, or anything in the garden…"
        rows="2"
        maxlength="1000"
        aria-label="Your message"
      ></textarea>
      <div class="chat-form-row">
        <span class="chat-disclaimer">The Garden can be wrong. Check the page.</span>
        <button type="submit" id="chat-send" class="chat-send" disabled>
          Send
        </button>
      </div>
    </form>
  </div>
</aside>

<script>
  import { initChatPanel } from '../scripts/chat-panel.ts';
  initChatPanel();
</script>

<style is:global>
  .chat-panel {
    position: fixed;
    inset: auto 0 0 auto;
    z-index: 80;
    font-family: var(--font-body);
    color: var(--color-text);
    pointer-events: none;
  }

  .chat-toggle {
    position: fixed;
    right: var(--space-lg);
    bottom: var(--space-lg);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-accent-2);
    border-radius: 999px;
    background: var(--color-bg-card);
    color: var(--color-accent-2);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 4px 12px var(--color-shadow);
    transition: transform var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
    pointer-events: auto;
    min-height: 44px;
  }

  .chat-toggle:hover {
    background: var(--color-accent-2);
    color: var(--color-bg);
    transform: translateY(-1px);
  }

  .chat-toggle:focus-visible {
    outline: 2px solid var(--color-accent-2);
    outline-offset: 3px;
  }

  .chat-toggle.is-hidden {
    display: none;
  }

  .chat-toggle-label {
    line-height: 1;
  }

  .chat-drawer {
    --chat-bg: var(--color-bg);
    --chat-bg-card: var(--color-bg-card);
    --chat-rule: var(--color-border);
    --chat-tag-bg: #ECE2CE;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--chat-drawer-width, 420px);
    max-width: 100vw;
    background: var(--chat-bg);
    border-left: 1px solid var(--chat-rule);
    box-shadow: -8px 0 24px var(--color-shadow);
    display: flex;
    flex-direction: column;
    pointer-events: auto;
    transform: translateX(100%);
    transition: transform 220ms ease;
  }

  .chat-drawer:not([hidden]) {
    transform: translateX(0);
  }

  .chat-drawer.is-maximized {
    width: 100vw !important;
  }

  .chat-resize {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -3px;
    width: 7px;
    cursor: col-resize;
    background: transparent;
    z-index: 1;
    transition: background var(--transition-fast);
  }

  .chat-resize:hover,
  .chat-resize.is-dragging {
    background: var(--color-accent-2);
    opacity: 0.4;
  }

  .chat-resize:focus-visible {
    outline: 2px solid var(--color-accent-2);
    outline-offset: 0;
    background: var(--color-accent-2);
    opacity: 0.4;
  }

  .chat-drawer.is-maximized .chat-resize {
    display: none;
  }

  .chat-header {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--chat-rule);
    background: var(--chat-bg-card);
  }

  .chat-header-titles {
    min-width: 0;
    flex: 1 1 auto;
  }

  .chat-header-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-heading);
    margin: 0 0 2px 0;
    line-height: 1.3;
  }

  .chat-header-context {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chat-header-context strong {
    color: var(--color-accent-2);
    font-weight: 500;
  }

  .chat-header-actions {
    display: flex;
    gap: 2px;
    flex: 0 0 auto;
  }

  .chat-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .chat-icon-btn:hover {
    background: var(--chat-tag-bg);
    color: var(--color-text);
  }

  .chat-icon-btn:focus-visible {
    outline: 2px solid var(--color-accent-2);
    outline-offset: 2px;
  }

  .chat-icon-btn .icon-restore { display: none; }
  .chat-drawer.is-maximized .chat-icon-btn .icon-maximize { display: none; }
  .chat-drawer.is-maximized .chat-icon-btn .icon-restore { display: inline; }

  .chat-settings-popover[hidden] {
    display: none;
  }
  .chat-settings-popover {
    position: absolute;
    top: calc(100% + 4px);
    right: var(--space-md);
    z-index: 10;
    min-width: 240px;
    padding: var(--space-sm) var(--space-md);
    background: var(--chat-bg-card);
    border: 1px solid var(--chat-rule);
    border-radius: 0.5rem;
    box-shadow: 0 4px 14px var(--color-shadow);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .chat-settings-label {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .chat-settings-select {
    width: 100%;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--chat-rule);
    border-radius: 0.4rem;
    background: var(--chat-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.85rem;
  }

  .chat-settings-hint {
    margin: 2px 0 0 0;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .chat-history {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .chat-empty {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.65;
    padding: var(--space-md) 0;
  }

  .chat-empty p {
    margin: 0 0 var(--space-md) 0;
  }

  .chat-empty p:last-child {
    margin-bottom: 0;
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .chat-suggestion {
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font: inherit;
    font-size: 0.78rem;
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast);
    text-align: left;
    font-family: var(--font-body);
  }

  .chat-suggestion:hover {
    background: var(--chat-tag-bg);
    border-color: var(--color-accent-2);
  }

  .chat-followups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: var(--space-sm) 0 var(--space-xs) 44px;
  }

  .chat-empty-followups {
    margin-left: 0;
  }

  .chat-followup {
    border: 1.5px solid rgba(0, 0, 0, 0.12);
    padding: 0.45rem 0.95rem 0.5rem;
    font: inherit;
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.25;
    color: var(--color-text);
    cursor: pointer;
    text-align: left;
    filter: url(#sketchy);
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    max-width: 100%;
  }

  .chat-followup:nth-child(3n+1) {
    border-radius: 30% 70% 60% 40% / 50% 40% 60% 50%;
    background: #E8D9B8;
    transform: rotate(-1.5deg);
  }
  .chat-followup:nth-child(3n+2) {
    border-radius: 60% 40% 35% 65% / 55% 50% 50% 45%;
    background: #D9B89A;
    transform: rotate(1.2deg);
  }
  .chat-followup:nth-child(3n+3) {
    border-radius: 40% 60% 70% 30% / 40% 55% 45% 60%;
    background: #C5D9C0;
    transform: rotate(-0.6deg);
  }

  .chat-followup:hover,
  .chat-followup:focus-visible {
    transform: rotate(0deg) translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    filter: none;
    outline: none;
  }

  [data-theme='dark'] .chat-drawer {
    --chat-tag-bg: #352E25;
  }

  [data-theme='dark'] .chat-followup {
    border-color: rgba(255, 255, 255, 0.18);
    color: #f5efe6;
  }
  [data-theme='dark'] .chat-followup:nth-child(3n+1) { background: #5a4a32; }
  [data-theme='dark'] .chat-followup:nth-child(3n+2) { background: #5a4332; }
  [data-theme='dark'] .chat-followup:nth-child(3n+3) { background: #3e5a48; }

  .chat-msg {
    display: flex;
    flex-direction: row;
    gap: var(--space-sm);
    align-items: flex-start;
    max-width: 100%;
  }

  .chat-avatar {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: 2px;
  }

  .chat-avatar-garden {
    background: transparent;
  }

  .chat-avatar-garden img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }

  .chat-avatar-user {
    background: transparent;
    border-radius: 0;
    overflow: visible;
    width: 34px;
    height: 34px;
    margin-top: -1px;
  }

  .chat-avatar-user img {
    width: 34px;
    height: 34px;
    object-fit: contain;
    display: block;
  }

  .chat-msg-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chat-msg-role {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .chat-msg-bubble {
    color: var(--color-text);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }

  .chat-msg-user .chat-msg-bubble {
    background: var(--chat-tag-bg);
    border-radius: 0.55rem;
    padding: 0.5rem 0.75rem;
    display: inline-block;
  }

  .chat-msg-bubble p {
    margin: 0 0 var(--space-md) 0;
    line-height: 1.65;
  }

  .chat-msg-bubble p:last-child {
    margin-bottom: 0;
  }

  .chat-msg-bubble strong {
    color: var(--color-heading);
    font-weight: 600;
  }

  .chat-msg-bubble em {
    font-style: italic;
  }

  .chat-msg-bubble a {
    color: var(--color-accent-2);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .chat-msg-bubble a:hover {
    color: var(--color-accent-2-hover);
    text-decoration-thickness: 2px;
  }

  .chat-msg-bubble code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--chat-tag-bg);
    padding: 0.05em 0.3em;
    border-radius: 3px;
  }

  .chat-msg-bubble ul,
  .chat-msg-bubble ol {
    padding-left: 1.2em;
    margin: 0 0 var(--space-md) 0;
  }

  .chat-msg-bubble li {
    margin: 4px 0;
  }

  .chat-msg-bubble li:last-child {
    margin-bottom: 0;
  }

  .chat-msg-bubble.is-error {
    color: #c00;
    border-left: 2px solid #c00;
    padding-left: var(--space-sm);
  }

  .chat-cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: var(--color-accent-2);
    vertical-align: text-bottom;
    margin-left: 2px;
    animation: chat-cursor-blink 1s steps(2, start) infinite;
  }

  @keyframes chat-cursor-blink {
    to { visibility: hidden; }
  }

  .chat-typing {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    padding: 4px 0;
  }

  .chat-typing-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-2);
    animation: chat-typing-pulse 1.2s infinite ease-in-out;
  }

  .chat-typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .chat-typing-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes chat-typing-pulse {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-2px); }
  }

  .chat-form {
    padding: var(--space-sm) var(--space-lg) var(--space-md);
    border-top: 1px solid var(--chat-rule);
    background: var(--chat-bg-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .chat-input {
    width: 100%;
    resize: none;
    border: 1px solid var(--chat-rule);
    border-radius: 1.1rem;
    padding: 0.6rem 0.95rem;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.5;
    background: var(--chat-bg);
    color: var(--color-text);
    transition: border-color var(--transition-fast);
  }

  .chat-input:focus {
    outline: none;
    border-color: var(--color-accent-2);
  }

  .chat-form-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .chat-disclaimer {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .chat-send {
    border: none;
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    background: var(--color-accent-2);
    color: var(--color-bg);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--transition-fast), opacity var(--transition-fast);
    min-height: 36px;
  }

  .chat-send:hover:not(:disabled) {
    background: var(--color-accent-2-hover);
  }

  .chat-send:focus-visible {
    outline: 2px solid var(--color-accent-2);
    outline-offset: 2px;
  }

  .chat-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  body.is-chat-resizing {
    cursor: col-resize !important;
    user-select: none;
  }

  @media (max-width: 800px) {
    .chat-drawer {
      width: 100vw !important;
      border-left: none;
    }
    .chat-resize {
      display: none;
    }
    .chat-toggle {
      right: var(--space-md);
      bottom: var(--space-md);
    }
  }
</style>
